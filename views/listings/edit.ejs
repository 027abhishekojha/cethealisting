<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Wanderlust listings</title>
</head>
<body>
<h3>Edit Wander Lust All Listing</h3>
<form method="post" action="/listings/<%=listing._id%>?_method=PUT">
Enter Post title : <input type="text" value="<%= listing.title%>" name="listing[title]"> <br> <br>
Enter Description : <textarea name="list[description]"><%= listing.description%></textarea> <br> <br>
Enter Image link in url : <input type="text" value="<%= listing.image%>" name="listing[image]"> <br> <br>
Enter Price : <input type="number" value="<%= listing.price%>" name="listing[price]"> <br> <br>
Enter location : <input type="text" value="<%= listing.location%>" name="listing[location]"> <br> <br>
Enter Country : <input type="text" value="<%= listing.country%>" name="listing[country]"> <br> <br>
<button type="submit">Update Post</button>
%>
</form>
</body>
</html>