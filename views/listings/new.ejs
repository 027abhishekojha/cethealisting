<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust Detail listings</title>
    <% layout("layouts/boilerplate") %>
</head>
<body>
<h3>Wander Create a New Post Page</h3>
<form method="POST" action="/listings">
    Enter Post Title :- <input type="text" placeholder="Post Title" name="listing[title]"> <br><br>
    Enter Description :- <input type="text" placeholder="Description" name="listing[description]"> <br><br>
    Enter Image Filename :- <input type="text" placeholder="Filename" name="listing[image.filename]"> <br><br>
    Enter Image URL :- <input type="text" placeholder="Image URL" name="listing[image.url]"> <br><br>
    Enter Price :- <input type="number" placeholder="Price" name="listing[price]"> <br><br>
    Enter Location :- <input type="text" placeholder="Location" name="listing[location]"> <br><br>
    Enter Country :- <input type="text" placeholder="Country" name="listing[country]"> <br><br>
    <button type="submit">Add Post</button>
</form>
</body>
